# ==============================================================================
# UBIcode Production Environment Variables (.env)
# Copy this file to .env on your AWS EC2 instance:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 64-character secret key for production (e.g. using openssl rand -hex 32)
SECRET_KEY=ubicode-production-master-secret-key-2024
RUN_RATE_LIMIT=30/minute

# ------------------------------------------------------------------------------
# 2. AWS S3 STORAGE & REGION
# ------------------------------------------------------------------------------
# S3 Bucket for candidate proctoring snapshots (created by your cloud team)
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET_NAME=ubicode-prod-s3-proctoring
S3_PHOTO_PREFIX=proctoring

# Note: In production on EC2 with an attached IAM Role, do NOT set AWS_ACCESS_KEY_ID
# or AWS_SECRET_ACCESS_KEY. Boto3 will automatically fetch credentials from the instance.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 3. INTERNAL CONTAINER NETWORKING (Default Docker Compose services)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/ubicode
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@postgres:5432/ubicode
REDIS_URL=redis://redis:6379/0
JUDGE0_URL=http://judge0-server:2358
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. MICROSOFT TEAMS ALERTING (Optional)
# ------------------------------------------------------------------------------
UBI_ALERTS_WEBHOOK_URL=
UBI_ALERTS_SERVICE=ubicode-api
UBI_ALERTS_ENVIRONMENT=production
UBI_ALERTS_ENABLED=false
